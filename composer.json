{
    "name": "eeomts/cubo",
    "description": "Cubo Framework - core PHP 8+",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "illuminate/database": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mpdf/mpdf": "^8.2"
    },
    "suggest": {
        "mpdf/mpdf": "^8.2 -- necessario para Cubo\\Tools\\Pdf (requer tambem a extensao gd)"
    },
    "autoload": {
        "psr-4": {
            "Cubo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cubo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        }
    }
}
