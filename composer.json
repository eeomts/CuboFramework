{
    "name": "netflex/netflexrefac",
    "description": "Netflex - Cubo Framework (core PHP 8+) e aplicacao",
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^11.0",
        "mpdf/mpdf": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Cubo\\": "app/Cubo2/src/",
            "PHPMailer\\PHPMailer\\": "app/Cubo2/PHPMailer/src/",
            "Netflex\\": "app/Netflex/src/",
            "Netflex\\Models\\": "app/Netflex/models_v2/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cubo\\Tests\\": "app/Cubo2/tests/",
            "Netflex\\Tests\\": "app/Netflex/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        }
    }
}
